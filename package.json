{
  "name": "marketing-teacher-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "fast-uri": "3.1.4",
      "hono": "4.12.32",
      "shell-quote": "1.10.0",
      "ws": "8.21.1"
    }
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "postbuild": "pnpm verify:content-review-output && pnpm verify:content-review-routes",
    "verify:content-review-output": "node scripts/verify-content-review-public-output.mjs",
    "verify:content-review-routes": "node scripts/verify-content-review-routes.mjs",
    "verify:cms-read-path": "node scripts/verify-cms-protected-route.mjs",
    "verify:cms-public-source": "node scripts/verify-cms-public-source.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-cms.ts",
    "cms:import": "tsx scripts/import-cms-homepage.ts",
    "cms:create-edit-link": "tsx scripts/create-cms-edit-link.ts",
    "cms:export-published": "tsx scripts/export-cms-publication.ts",
    "cms:backup-database": "node scripts/backup-cms-database.mjs",
    "gen:hero-images": "node scripts/gen-hero-images.mjs",
    "gen:reveal-photos": "node scripts/gen-reveal-photos.mjs",
    "gen:school-art": "node scripts/gen-school-art.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@govtechsg/sgds-web-component": "^3.18.1",
    "@mdx-js/mdx": "^3.1.1",
    "@radix-ui/colors": "^3.0.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "@vercel/functions": "3.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.9.0",
    "mdast-util-to-string": "^4.0.0",
    "motion": "^12.38.0",
    "pg": "8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.15",
    "@types/pg": "8.21.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "jsdom": "^27.4.0",
    "made-refine": "^0.2.20",
    "nitro": "3.0.260415-beta",
    "postcss": "^8.5.24",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.16.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6"
  }
}
