# Pooled PostgreSQL URL used by the running app.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Direct PostgreSQL URL used only by migration commands.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Keep this small for serverless or Fluid Compute deployments.
DATABASE_POOL_MAX=5

# Keep `static` until the CMS replacement has final approval. Changing this
# value needs a new deployment; there is no silent runtime fallback.
CONTENT_SOURCE=static

# Run `pnpm cms:create-edit-link` once. Store the hash and cookie secret, then
# share only the generated link. Do not reuse the database password.
CMS_EDIT_KEY_HASH=
CMS_COOKIE_SECRET=
