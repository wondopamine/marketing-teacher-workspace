# Pooled PostgreSQL URL used by the running app.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Direct PostgreSQL URL used only by migration commands.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Keep this small for serverless or Fluid Compute deployments.
DATABASE_POOL_MAX=5

# CMS access values are added in Phase 3. Do not reuse the database password.
CMS_EDIT_KEY=
CMS_COOKIE_SECRET=
CMS_CSRF_SECRET=
